#endif
			break;

		case ACQUISIZIONE:
		{
			adc_done = 0;
			adc_err = 0;
			dma_err = 0;

			__HAL_ADC_CLEAR_FLAG(&hadc2, ADC_FLAG_EOC | ADC_FLAG_EOS | ADC_FLAG_OVR);
			//pulisco i flag dell'adc

			adc_done2 = 0;
			adc_err2 = 0;
			dma_err2 = 0;

			__HAL_ADC_CLEAR_FLAG(&hadc1, ADC_FLAG_EOC | ADC_FLAG_EOS | ADC_FLAG_OVR);

			if(prima_acq){
				HAL_ADC_Stop_DMA(&hadc2); //stop dell'adc
				HAL_ADC_DeInit(&hadc2); //deinizializzazione adc (altrimenti invio sempre
				//lo stesso buffer
				MX_ADC2_Init(); //reinizializzo

				HAL_ADC_Stop_DMA(&hadc1); //stop dell'adc
				HAL_ADC_DeInit(&hadc1); //deinizializzazione adc (altrimenti invio sempre
				//lo stesso buffer
				MX_ADC1_Init(); //reinizializzo
			}

			HAL_StatusTypeDef ret = HAL_ADC_Start_DMA(&hadc2, (uint32_t *)adc_buf, NUM_SAMPLES);
			HAL_StatusTypeDef ret2 = HAL_ADC_Start_DMA(&hadc1, (uint32_t *)adc_buf2, NUM_SAMPLES);

			if (ret != HAL_OK)
			{
				adc_err = HAL_ADC_GetError(&hadc1);
				Error_Handler();
			}

			if (ret2 != HAL_OK)
			{
				adc_err2 = HAL_ADC_GetError(&hadc2);
				Error_Handler();
			}

			while (!adc_done || !adc_done2)
			{
				__WFI();
			}

			SCB_InvalidateDCache_by_Addr((uint32_t *)adc_buf, NUM_SAMPLES * sizeof(uint32_t));
			SCB_InvalidateDCache_by_Addr((uint32_t *)adc_buf2, NUM_SAMPLES * sizeof(uint32_t));

			//toglie dalla d chache la vecchia copia del buffer, così la cpu legge i campioni
			//reali scritti dal buffer in ram (senza invalidazione cache la cpu legge i valori
			//della prima asìcquisizione invece dei nuovi

			for (uint32_t i = 0; i < NUM_SAMPLES; i++)
			{
				uart_tx_buf[i] = (uint8_t)(adc_buf[i] & 0xFFU);
				uart_tx_buf2[i]= (uint8_t)(adc_buf2[i] & 0xFFU);
			}

			HAL_Delay(100);

			flag_fetch_1 = 0;
			prima_acq=1;
			//state = ATTESA_FETCH;
			state = CLASSIFICAZIONE;


			break;
		}

		case CLASSIFICAZIONE:

			nn_preprocess_status_t st;
			uint64_t pre_p_time = DWT_CyclesUs();
			st = nn_preprocess_adc_u8_to_int8(uart_tx_buf, nn_input, &pp_workspace, &pp_info);
			uint64_t post_p_time = DWT_CyclesUs();
			preprocess_latency[latency_cycle-1] = post_p_time - pre_p_time;

			if (st != NN_PREPROCESS_OK)
			{
				continue;
			}

			if (nn_in_len != NN_PREPROCESS_INPUT_FEATURES)
			{
				Error_Handler();
			}

			//memcpy(nn_in, nn_input, nn_in_len); // FROM ADC
#if NN_TRACE_TO_USE == NN_DUMMY_TRACE_INDOTTO
			const int8_t *selected_input = DUMMY_TRACE_INDOTTO_INT8;
#elif NN_TRACE_TO_USE == NN_DUMMY_TRACE_AUTOINDOTTO
			const int8_t *selected_input = DUMMY_TRACE_AUTOINDOTTO_INT8;
#elif NN_TRACE_TO_USE == NN_ACQUIRED_TACE
			const int8_t *selected_input = nn_input;
#else
#error "NN_DUMMY_TRACE_TO_USE non valido"
#endif

