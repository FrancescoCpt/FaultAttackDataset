/* USER CODE BEGIN 4 */
void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
	if (huart->Instance == LPUART1)
	{
		if (rx_byte[0] == '\r') {

			if (strcmp(rx_buffer, "S") == 0) {
				flag_dummy_choice = 0;
				flag_start_acquisition = 1;
			} else if (strcmp(rx_buffer, "Y") == 0) {
				flag_dummy_choice = 1;
				flag_start_acquisition = 1;
			} else if (strncmp(rx_buffer, "F1", 2) == 0) {
				flag_fetch_1 = 1;
			} else if (strncmp(rx_buffer, "F2", 2) == 0) {
				flag_fetch_2 = 1;
			} else if (strncmp(rx_buffer, "FP", 2) == 0) {
				state = FETCH_PREDICTION;
			}

			rx_indice = 0;																	// Azzero l'indice e pulisco il buffer per il prossimo messaggio
			memset(rx_buffer, 0, sizeof(rx_buffer));
		}

		else {

			if (rx_indice < 99) {
				rx_buffer[rx_indice++] = rx_byte[0];
			}
		}

		HAL_UART_Receive_IT(&hlpuart1, (uint8_t *)rx_byte, 1);
	}
}

void HAL_GPIO_EXTI_Rising_Callback(uint16_t GPIO_Pin)
{
	if(GPIO_Pin == GPIO_PIN_13) // Sostituisci con il nome o numero del tuo pin
