					sum_p += preprocess_latency[n];
				}
				float mean_p = sum_p / PIPE_LATENCY_NUM;

				volatile float std_p_s = 0;
				for(int n=0; n<PIPE_LATENCY_NUM; n++) {
					std_p_s += (float)((float)preprocess_latency[n] - mean_p);
				}
				volatile float std_p_b = std_p_s / PIPE_LATENCY_NUM;
				volatile float std_p = sqrt(std_p_b);



				latency_cycle = 0;
