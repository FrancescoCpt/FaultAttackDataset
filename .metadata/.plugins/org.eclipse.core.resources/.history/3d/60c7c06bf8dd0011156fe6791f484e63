void enable_dwt_cycle_counter(void) {
	CoreDebug->DEMCR |= CoreDebug_DEMCR_TRCENA_Msk; // Enable access to DWT and ITM
	DWT->CYCCNT = 0; // Reset the cycle counter
	DWT->CTRL |= DWT_CTRL_CYCCNTENA_Msk; // Enable cycle counter
}

static inline uint32_t get_current_cycle(void){
	return (uint32_t) DWT->CYCCNT;
}

static inline uint64_t DWT_CyclesUs(void)
{
	uint32_t cycles = (uint32_t) DWT->CYCCNT;
	return (((uint64_t)cycles * 1000000ULL) / SystemCoreClock) / 100;
}

static void CleanDCacheRange(const void *addr, uint32_t len)
{
	uintptr_t start = ((uintptr_t)addr) & ~31UL;
	uintptr_t end = (((uintptr_t)addr) + len + 31UL) & ~31UL;

	SCB_CleanDCache_by_Addr((uint32_t *)start, (int32_t)(end - start));
}

static void InvalidateDCacheRange(const void *addr, uint32_t len)
{
	uintptr_t start = ((uintptr_t)addr) & ~31UL;
	uintptr_t end = (((uintptr_t)addr) + len + 31UL) & ~31UL;

	SCB_InvalidateDCache_by_Addr((uint32_t *)start, (int32_t)(end - start));
}

static int8_t QuantizeLogitToInt8(float value)
{
	float scaled = value / NN_LOGITS_SCALE;
	int32_t quantized;

	if (scaled >= 0.0f)
	{
		quantized = (int32_t)(scaled + 0.5f);
	}
	else
	{
		quantized = (int32_t)(scaled - 0.5f);
	}

	quantized += NN_LOGITS_ZERO_POINT;

	if (quantized > 127)
	{
		quantized = 127;
	}
	else if (quantized < -128)
	{
		quantized = -128;
	}

	return (int8_t)quantized;
}

static void CopyNetworkInput(volatile int8_t *dst, const int8_t *src, uint32_t len)
{
	for (uint32_t i = 0; i < len; i++)
	{
		dst[i] = src[i];
	}

	__DSB();
	__ISB();
}

static void NetworkInputCallback(LL_ATON_RT_Callbacktype_t ctype,
		const NN_Instance_TypeDef *nn_instance,
		const EpochBlock_ItemTypeDef *epoch_block)
{
	(void)nn_instance;
	(void)epoch_block;

	if ((ctype == LL_ATON_RT_Callbacktype_PRE_START) && (nn_pending_input_copy != 0u))
	{
		LL_ATON_Cache_NPU_Clean_Invalidate_Range((uintptr_t)nn_pending_input_dst, nn_pending_input_len);
		CopyNetworkInput(nn_pending_input_dst, nn_pending_input_src, nn_pending_input_len);
		CleanDCacheRange((const void *)nn_pending_input_dst, nn_pending_input_len);
		__DSB();
		__ISB();
		LL_ATON_Cache_NPU_Invalidate();
		nn_pending_input_copy = 0u;
	}

#ifdef LL_ATON_EB_DBG_INFO
	if (ctype == LL_ATON_RT_Callbacktype_POST_END)
	{
		if (epoch_block->epoch_num == 8u)
		{
			volatile float *final_float = (volatile float *)NN_FINAL_FLOAT_ADDR;

			InvalidateDCacheRange((const void *)NN_FINAL_FLOAT_ADDR, 32UL);
			nn_debug_cpu_logits[0] = QuantizeLogitToInt8(final_float[0]);
			nn_debug_cpu_logits[1] = QuantizeLogitToInt8(final_float[1]);
		}
		else if (epoch_block->epoch_num == 10u)
		{
			volatile int8_t *softmax_input = (volatile int8_t *)NN_SOFTMAX_INPUT_ADDR;

			InvalidateDCacheRange((const void *)NN_SOFTMAX_INPUT_ADDR, 32UL);
			softmax_input[0] = nn_debug_cpu_logits[0];
			softmax_input[1] = nn_debug_cpu_logits[1];
			CleanDCacheRange((const void *)NN_SOFTMAX_INPUT_ADDR, 32UL);
		}
	}
#endif
}

static void RunNetworkWithInput(NN_Instance_TypeDef *network_instance,
		volatile int8_t *input_dst,
		uint32_t input_len,
		const int8_t *input_src)
{
	LL_ATON_RT_RetValues_t ll_aton_rt_ret;

	nn_pending_input_dst = input_dst;
	nn_pending_input_src = input_src;
	nn_pending_input_len = input_len;
	nn_pending_input_copy = 1u;

	LL_ATON_RT_SetNetworkCallback(network_instance, NetworkInputCallback);
	LL_ATON_RT_RuntimeInit();
	LL_ATON_RT_Init_Network(network_instance);

	uint64_t pre_n_time = DWT_CyclesUs();
	do
	{
		ll_aton_rt_ret = LL_ATON_RT_RunEpochBlock(network_instance);

	} while (ll_aton_rt_ret != LL_ATON_RT_DONE);
	uint64_t post_n_time = DWT_CyclesUs();
	network_latency[latency_cycle-1] = post_n_time - pre_n_time;

	LL_ATON_RT_DeInit_Network(network_instance);
	LL_ATON_RT_SetNetworkCallback(network_instance, NULL);
	LL_ATON_RT_RuntimeDeInit();
}
