				RunNetworkWithInput(&NN_Instance_Default, (volatile int8_t *)nn_in, nn_in_len, DUMMY_TRACE_AUTOINDOTTO_INT8);
			}
			//InvalidateDCacheRange(nn_out, nn_out_len);
			//RunNetworkWithInput(&NN_Instance_Default, (volatile int8_t *)nn_in, nn_in_len, selected_input);

			memcpy(last_out_buffer, nn_out, nn_out_len);
			if (nn_out_len >= 2)
			{
				volatile int8_t *softmax_input = (volatile int8_t *)NN_SOFTMAX_INPUT_ADDR;
				nn_debug_softmax_input[0] = softmax_input[0];
				nn_debug_softmax_input[1] = softmax_input[1];
				InvalidateDCacheRange(nn_out, nn_out_len);
			}

#if WAIT_FETCH == 1
			char c = 'E';
			HAL_UART_Transmit(&hlpuart1, (uint8_t *)&c, 1, HAL_MAX_DELAY);

			state = FETCH_PREDICTION; //ATTESA_FETCH_1;
#else
			state = IDLE;
#endif
			break;

		case ACQUISIZIONE_2:

			flag_fetch_1 = 0;
			prima_acq=1;
			HAL_Delay(100);
			state = CLASSIFICAZIONE;
			break;

		case ATTESA_FETCH_1:
			if (flag_fetch_1 == 1)
			{
				flag_fetch_1 = 0;
				state = INVIO_1;
			}
			break;

		case INVIO_1:
		{
			for (uint32_t i = 0; i < NUM_SAMPLES; i++)
			{
				int len = snprintf(buf_tras, sizeof(buf_tras), "%u\r\n", uart_tx_buf[i]);

				if (len > 0)
				{
					HAL_UART_Transmit(&hlpuart1, (uint8_t *)buf_tras, (uint16_t)len, HAL_MAX_DELAY);
				}
			}

			char c = ':';
			HAL_UART_Transmit(&hlpuart1, (uint8_t *)&c, 1, HAL_MAX_DELAY);

			state = ATTESA_FETCH_2;
			break;
		}

		case ATTESA_FETCH_2:
			if (flag_fetch_2 == 1)
			{
				flag_fetch_2 = 0;
				state = INVIO_2;
			}
			break;

		case INVIO_2:
		{
			for (uint32_t i = 0; i < NUM_SAMPLES; i++)
			{
				int len2 = snprintf(buf_tras2, sizeof(buf_tras), "%u\r\n", uart_tx_buf2[i]);


				if (len2 > 0)
				{
					HAL_UART_Transmit(&hlpuart1, (uint8_t *)buf_tras2, (uint16_t)len2, HAL_MAX_DELAY);
				}
			}

			char c = ':';
			HAL_UART_Transmit(&hlpuart1, (uint8_t *)&c, 1, HAL_MAX_DELAY);

			state = IDLE;
			break;
		}

		case FETCH_PREDICTION:

			for (uint32_t i = 0; i < nn_out_len; i++)
			{
				float probability = ((float)((int32_t)last_out_buffer[i] - NN_OUTPUT_ZERO_POINT)) * NN_OUTPUT_SCALE;
				if (probability < 0.0f)
				{
					probability = 0.0f;
				}
				else if (probability > 1.0f)
				{
					probability = 1.0f;
				}

				uint32_t probability_milli = (uint32_t)((probability * 1000.0f) + 0.5f);
				int len = snprintf(buf_tras_pred, sizeof(buf_tras_pred), "%lu.%03lu\r\n",
						(unsigned long)(probability_milli / 1000u),
						(unsigned long)(probability_milli % 1000u));

				if (len > 0)
				{
					HAL_UART_Transmit(&hlpuart1, (uint8_t *)buf_tras_pred, (uint16_t)len, HAL_MAX_DELAY);
				}
			}

			HAL_UART_Transmit(&hlpuart1, (uint8_t *)&LAST_CHAR, 1, HAL_MAX_DELAY);

			state = IDLE;
			break;
